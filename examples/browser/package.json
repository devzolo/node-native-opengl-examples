{
  "name": "browser",
  "version": "1.0.0",
  "main": "dist",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "cross-env NODE_ENV=development node --watch --experimental-transform-types --no-warnings src/index.ts",
    "build": "tsc",
    "start": "node ./dist/index.js",
        "test": "node --test --experimental-transform-types --no-warnings",
    "test:watch": "node --test --watch --experimental-transform-types --no-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "biome format",
    "format:fix": "biome format --write",
    "lint": "biome lint",
    "clean": "rimraf dist"
  },
  "yarn-upgrade-all": {
    "ignore": [
      "config",
      "tsconfig"
    ]
  },
  "dependencies": {
    "@devzolo/node-native-browser": "link:../node-native-browser",
    "@devzolo/node-native-gl": "link:../node-native-gl",
    "@devzolo/node-native-glm": "link:../node-native-glm",
    "@devzolo/node-native-glu": "link:../node-native-glu",
    "@devzolo/node-native-glut": "link:../node-native-glut",
    "@devzolo/node-native-sound": "link:../node-native-sound",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "cross-env": "^10.0.0",
    "rimraf": "^6.0.1",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
