{
  "name": "utils",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --watch --experimental-transform-types --no-warnings src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node ./dist/index.js",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint ./src --ext .js,.jsx,.ts,.tsx --fix",
        "test": "node --test --experimental-transform-types --no-warnings",
    "test:watch": "node --test --watch --experimental-transform-types --no-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "bmp-js": "^0.1.0",
    "cross-env": "^10.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/bmp-js": "^0.1.0",
    "@types/node": "^24.3.1",
    "@types/pngjs": "^6.0.5",
    "rimraf": "^6.0.1",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
